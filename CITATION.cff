url: "https://github.com/kydno/YouTube-Channel-Transcript-Fetcher"
license: MIT
version: "1.2.4"
date-released: "2026-05-19"
keywords:
  - youtube
  - youtube transcripts
  - youtube channel
  - subtitles
  - captions
  - transcript export
  - llm
  - rag
  - yt-dlp
